# --- core ---
WT_ENV=dev                                  # dev | test | staging | prod
WT_PUBLIC_BASE_URL=http://localhost:8000    # this API's public URL (used in email links)
WT_FRONTEND_BASE_URL=http://localhost:3000
WT_CORS_ORIGINS=http://localhost:3000
WT_LOG_JSON=true
WT_SIGNING_SECRET=change-me-to-64-random-chars    # HMAC for unsubscribe/feedback/ics links (rotate = links expire)
WT_ENCRYPTION_KEY=                          # Fernet key for webhook secrets (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")

# --- datastores ---
# Supabase: use the *session* pooler or direct connection string for workers; the API also works via the transaction pooler.
WT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54329/watchtower
WT_REDIS_URL=redis://127.0.0.1:6379/0

# --- Supabase Auth ---
WT_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
WT_SUPABASE_ANON_KEY=
WT_SUPABASE_SERVICE_ROLE_KEY=               # server-side only: account deletion, verification checks
WT_SUPABASE_JWT_SECRET=                     # only if the project still uses legacy HS256 keys
WT_AUTH_HOOK_SECRET=                        # "Before user created" hook secret (v1,whsec_...)

# --- LLM (Groq) ---
WT_GROQ_API_KEY=
WT_LLM_MODEL_FAST=openai/gpt-oss-20b
WT_LLM_MODEL_SMART=openai/gpt-oss-120b
WT_LLM_MODEL_FALLBACK=llama-3.3-70b-versatile
WT_LLM_DAILY_BUDGET_USD=10                  # soft cap: free tier degrades to rule-only beyond this; hard cap = 2x

# --- search ---
WT_TAVILY_API_KEY=
WT_BRAVE_API_KEY=
WT_SEARCH_DAILY_BUDGET_CALLS=2000

# --- fetching ---
WT_FETCH_USER_AGENT=WatchtowerBot/1.0 (+https://watchtower.app/bot)
WT_RENDER_ENABLED=false                     # true only on workers built from the `render` image target

# --- notifications ---
WT_EMAIL_PROVIDER=console                   # resend | smtp | console
WT_RESEND_API_KEY=
WT_RESEND_WEBHOOK_SECRET=                   # whsec_...
WT_EMAIL_FROM=Watchtower <alerts@yourdomain.com>
WT_VAPID_PUBLIC_KEY=                        # scripts/gen_vapid.py
WT_VAPID_PRIVATE_KEY=
WT_VAPID_SUBJECT=mailto:admin@yourdomain.com
WT_TELEGRAM_BOT_TOKEN=
WT_TELEGRAM_BOT_USERNAME=WatchtowerAlertsBot
WT_TELEGRAM_WEBHOOK_SECRET=                 # random string; set via setWebhook secret_token

# --- observability ---
WT_OTEL_EXPORTER_OTLP_ENDPOINT=             # e.g. http://jaeger:4318
WT_METRICS_TOKEN=                           # protects /metrics when set
